# LLM provider toggle: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6           # or claude-opus-4-7 for richer creative copy
OPENAI_API_KEY=sk-...                       # required only if LLM_PROVIDER=openai or as runtime fallback
OPENAI_MODEL=gpt-4o

# Context signals
OPENWEATHER_API_KEY=...
TICKETMASTER_API_KEY=...                    # https://developer.ticketmaster.com (free: 5000/day, 5 req/sec)

# Maps provider toggle: google | osm
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=...                     # Static Maps + Geocoding APIs enabled. Restrict to localhost + Vercel domain. Set per-SKU daily cap.
OSM_USER_AGENT=city-wallet-hackathon/1.0 (contact@example.com)

# Redis (Upstash REST credentials in deploy, plain redis URL in local dev)
KV_REST_API_URL=...                         # auto-injected by Upstash Vercel integration
KV_REST_API_TOKEN=...
# Local dev alternative:
# REDIS_URL=redis://localhost:6379

# Demo controls — when true, fetchers prefer fixtures, force-overrides honored
DEMO_MODE=false

# Frontend mock toggle — flip to "false" once feat/context lands on main
NEXT_PUBLIC_MOCK=true
